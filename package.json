{
  "name": "rattle",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "updates:native": "node scripts/configure-native-updates.cjs",
    "test": "jest",
    "docs:api": "python3 -m http.server 8732 --bind 127.0.0.1 --directory docs/api",
    "test:sql": "node scripts/validate-operations-sql.mjs && node scripts/validate-release-sql.mjs && node scripts/validate-read-models-sql.mjs && node scripts/validate-pos-read-models.mjs && node scripts/validate-financial-sharing.mjs && node scripts/validate-regular-wages-sql.mjs && node scripts/validate-daily-work-sql.mjs && node scripts/validate-payroll-snapshot-integration.mjs && node scripts/validate-store-soft-delete-sql.mjs && node scripts/validate-rls-auth-initplan-sql.mjs && node scripts/validate-rls-auth-wrapping.mjs && node scripts/validate-store-bootstrap-sql.mjs && node scripts/validate-home-daily-sources-sql.mjs && node scripts/validate-pos-unchanged-sql.mjs && node scripts/validate-qr-attendance-sql.mjs && node scripts/validate-role-model-sql.mjs && node scripts/validate-store-visibility-sql.mjs && node scripts/validate-manager-role-integration-sql.mjs && node scripts/validate-evidence-sql.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/setup\\.ts",
      "/.worktrees/",
      "<rootDir>/supabase/functions/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|@supabase/.*|@noble/hashes/.*|standard-navigation)"
    ],
    "moduleNameMapper": {
      "^@expo/vector-icons$": "<rootDir>/__mocks__/@expo/vector-icons.js",
      "^@expo/vector-icons/(.*)$": "<rootDir>/__mocks__/@expo/vector-icons.js"
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/.worktrees/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.animations.js"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@noble/hashes": "2.4.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "@supabase/supabase-js": "^2.99.3",
    "@tanstack/react-query": "^5.104.5",
    "@types/papaparse": "^5.5.2",
    "expo": "^57.0.33",
    "expo-apple-authentication": "~57.0.2",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.23",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.24",
    "expo-crypto": "~57.0.4",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.22",
    "expo-image-picker": "~57.0.21",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.14",
    "expo-router": "~57.0.31",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.28",
    "expo-web-browser": "~57.0.3",
    "node": "^22.22.2",
    "papaparse": "^5.5.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-pager-view": "8.0.2",
    "react-native-qrcode-svg": "^6.3.54",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "@types/react-native": "^0.72.8",
    "babel-preset-expo": "~57.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3"
  },
  "private": true
}
