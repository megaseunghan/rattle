{
  "name": "rattle",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "docs:api": "python3 -m http.server 8732 --bind 127.0.0.1 --directory docs/api",
    "test:sql": "node scripts/validate-operations-sql.mjs && node scripts/validate-release-sql.mjs && node scripts/validate-read-models-sql.mjs && node scripts/validate-pos-read-models.mjs && node scripts/validate-financial-sharing.mjs && node scripts/validate-regular-wages-sql.mjs && node scripts/validate-daily-work-sql.mjs && node scripts/validate-payroll-snapshot-integration.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/setup\\.ts",
      "/.worktrees/",
      "<rootDir>/supabase/functions/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|@supabase/.*)"
    ],
    "moduleNameMapper": {
      "^@expo/vector-icons$": "<rootDir>/__mocks__/@expo/vector-icons.js",
      "^@expo/vector-icons/(.*)$": "<rootDir>/__mocks__/@expo/vector-icons.js"
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/.worktrees/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.animations.js"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.4",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-community/slider": "5.1.2",
    "@supabase/supabase-js": "^2.99.3",
    "@tanstack/react-query": "^5.104.5",
    "@types/papaparse": "^5.5.2",
    "expo": "~55.0.8",
    "expo-apple-authentication": "~55.0.17",
    "expo-blur": "~55.0.14",
    "expo-constants": "~55.0.9",
    "expo-crypto": "~55.0.19",
    "expo-device": "~55.0.10",
    "expo-document-picker": "~55.0.9",
    "expo-font": "~55.0.4",
    "expo-linking": "~55.0.8",
    "expo-router": "~55.0.7",
    "expo-secure-store": "~55.0.18",
    "expo-splash-screen": "^55.0.12",
    "expo-status-bar": "~55.0.4",
    "expo-web-browser": "~55.0.14",
    "node": "^22.22.2",
    "papaparse": "^5.5.3",
    "react": "19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "0.83.2",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-maps": "1.27.2",
    "react-native-pager-view": "8.0.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "@types/react-native": "^0.72.8",
    "babel-preset-expo": "^55.0.12",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.11",
    "typescript": "~5.9.2"
  },
  "private": true
}
