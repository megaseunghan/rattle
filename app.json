{
  "expo": {
    "name": "rattle",
    "slug": "rattle",
    "privacyPolicyUrl": "https://megaseunghan.github.io/rattle/privacy-policy.html",
    "scheme": "rattle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Rattle_ios_1024.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-blank.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/Rattle_ios_1024.png",
      "bundleIdentifier": "com.seunghan.rattle",
      "buildNumber": "1"
    },
    "android": {
      "icon": "./assets/Rattle_512x512.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/Rattle_adaptive_fg.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.seunghan.rattle",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/Rattle_192x192.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "납품서 촬영을 위해 카메라 접근이 필요합니다."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-secure-store"
    ]
  }
}
