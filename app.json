{
  "expo": {
    "name": "rattle",
    "slug": "rattle",
    "privacyPolicyUrl": "https://megaseunghan.github.io/rattle/privacy-policy.html",
    "scheme": "rattle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Rattle_ios_1024.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/Rattle_ios_1024.png",
      "bundleIdentifier": "com.seunghan.rattle",
      "buildNumber": "1"
    },
    "android": {
      "icon": "./assets/Rattle_512x512.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/Rattle_adaptive_fg.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.seunghan.rattle",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/Rattle_192x192.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/Rattle_1024x1024.png",
          "imageWidth": 144,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-secure-store"
    ]
  }
}
