{
  "expo": {
    "name": "rattle",
    "slug": "rattle",
    "privacyPolicyUrl": "https://megaseunghan.github.io/rattle/privacy-policy.html",
    "scheme": "rattle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Rattle_ios_1024.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "icon": "./assets/Rattle_ios_1024.png",
      "bundleIdentifier": "com.seunghan.rattle",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/Rattle_512x512.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/Rattle_adaptive_fg.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.seunghan.rattle",
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/Rattle_192x192.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-secure-store",
      "expo-apple-authentication"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1522aa21-1ffc-4a8c-b13c-c572ebbb3719"
      }
    },
    "owner": "megaseunghan",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1522aa21-1ffc-4a8c-b13c-c572ebbb3719",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    }
  }
}
